{
  "name": "@hope/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx --watch --env-file=../../.env --env-file=../../.env.local src/serve.ts",
    "dev:wrangler": "bash scripts/dev.sh",
    "dev:node": "tsx --watch --env-file=../../.env --env-file=../../.env.local src/serve.ts",
    "start": "tsx src/serve.ts",
    "test": "tsx --test src/**/*.test.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "dump-openapi": "tsx scripts/dump-openapi.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@clerk/backend": "^3.18.1",
    "@hono/node-server": "^2.1.1",
    "@hono/standard-validator": "^0.4.0",
    "@hope/core": "workspace:*",
    "@hope/db": "workspace:*",
    "@hope/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.1",
    "@standard-community/standard-json": "^0.3.6",
    "@standard-community/standard-openapi": "^0.2.10",
    "@types/json-schema": "^7.0.15",
    "hono": "^4.13.7",
    "hono-openapi": "^1.3.3",
    "openapi-types": "^12.1.3",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.135.0"
  }
}
